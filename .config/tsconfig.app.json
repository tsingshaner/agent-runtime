{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ESNext"],
    "paths": {
      "@internal/shared": ["../packages/shared/src/index.ts"],
      "@qingshaner/runtime": ["../packages/runtime/src/index.ts"],
      "@qingshaner/runtime-codex": ["../packages/runtime-codex/src/index.ts"]
    },
    "resolveJsonModule": true,
    "rootDir": "..",
    "target": "ESNext",
    "types": ["node"]
  },
  "extends": "@qingshaner/devtools/tsconfig/base.json",
  "include": ["../packages/**/*.ts", "../examples/**/*.ts"]
}
