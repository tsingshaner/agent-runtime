{
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["vite/client", "node"]
  },
  "exclude": ["dist", "node_modules"],
  "extends": "../../.config/tsconfig.app.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
