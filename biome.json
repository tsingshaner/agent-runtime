{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@qingshaner/devtools/biome"],
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.bench.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          },
          "nursery": {
            "useExplicitType": "off"
          }
        }
      }
    },
    {
      "assist": {
        "enabled": false
      },
      "includes": ["package.json"]
    }
  ]
}
