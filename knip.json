{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["packages/runtime-codex/src/schemas/**"],
  "ignoreBinaries": ["codex"],
  "ignoreDependencies": ["drizzle-kit"],
  "tags": ["-lintignore"],
  "workspaces": {
    "apps/server": {
      "entry": ["src/lifecycle.ts", "src/index.ts", "*-smoke.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "examples/*": {
      "entry": ["*.test.ts"],
      "project": ["*.ts"]
    },
    "examples/probe-codex": {
      "entry": ["*.test.ts", "mcp.ts"],
      "project": ["*.ts"]
    },
    "examples/probe-dsh": {
      "ignoreDependencies": ["@deepseek-ai/dsh"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/mcp": {
      "entry": ["src/index.ts", "test/server.fixture.ts"]
    },
    "packages/memory": {
      "entry": ["src/index.ts", "test/gateway.fixture.ts"]
    },
    "packages/shared": {
      "ignoreDependencies": ["es-toolkit"]
    }
  }
}
